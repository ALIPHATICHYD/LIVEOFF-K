# Supabase project settings -> API. Safe to expose to the browser (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server only. Used to mark escrow payments as paid after Paystack confirms them. Never expose.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Paystack dashboard -> Settings -> API Keys & Webhooks. Server only.
PAYSTACK_SECRET_KEY=sk_test_xxx

# Public URL of the site, used for the Paystack return link.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo sign-in button on /login (Supabase anonymous auth). Set to "off" before launch.
NEXT_PUBLIC_DEMO_LOGIN=on
